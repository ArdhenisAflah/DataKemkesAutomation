# ============================================================
# Template konfigurasi untuk DataKemkes Automation
#
# Cara pakai:
#   1. Salin file ini: copy .env.example .env
#   2. Isi nilai di bawah dengan kredensial kamu
#   3. Jangan pernah commit file .env ke GitHub!
# ============================================================

# Kredensial login SIM-Keswa Kemenkes RI
SIMKESWA_USERNAME=nomor_id_kamu_disini
SIMKESWA_PASSWORD=password_kamu_disini

# Jumlah maksimal data yang dihapus per sekali jalan (epds_auto_delete.py)
MAX_DELETIONS=100
